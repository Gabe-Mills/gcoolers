---
/**
 * Client-only thermal instrument for the hero canvas.
 * Loaded via <script src> from the homepage.
 */
---

<script>
  function bootThermal() {
    const canvas = document.getElementById("thermal") as HTMLCanvasElement | null;
    if (!canvas) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf = 0;
    let t0 = performance.now();

    const particles: { x: number; y: number; vx: number; vy: number; life: number; hue: number }[] =
      [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas!.clientWidth;
      h = canvas!.clientHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function spawn(n = 2) {
      for (let i = 0; i < n; i++) {
        particles.push({
          x: w * (0.45 + Math.random() * 0.5),
          y: h * (0.55 + Math.random() * 0.35),
          vx: -0.2 - Math.random() * 0.6,
          vy: -0.6 - Math.random() * 1.4,
          life: 0.6 + Math.random() * 0.8,
          hue: Math.random() > 0.45 ? 110 : Math.random() > 0.5 ? 45 : 220,
        });
      }
    }

    function drawFrame(now: number) {
      const t = (now - t0) / 1000;
      ctx!.clearRect(0, 0, w, h);

      // Heat field
      const g = ctx!.createRadialGradient(
        w * 0.72,
        h * 0.58,
        20,
        w * 0.72,
        h * 0.58,
        Math.max(w, h) * 0.55,
      );
      const pulse = 0.5 + 0.5 * Math.sin(t * 1.1);
      g.addColorStop(0, `oklch(${0.55 + pulse * 0.1} 0.18 45 / ${0.55})`);
      g.addColorStop(0.35, `oklch(0.5 0.14 110 / ${0.28 + pulse * 0.1})`);
      g.addColorStop(0.7, `oklch(0.35 0.1 220 / 0.18)`);
      g.addColorStop(1, `oklch(0.08 0 0 / 0)`);
      ctx!.fillStyle = g;
      ctx!.fillRect(0, 0, w, h);

      // Chassis silhouette
      const cx = w * 0.68;
      const cy = h * 0.52;
      const bw = Math.min(w * 0.42, 520);
      const bh = bw * 0.62;
      ctx!.save();
      ctx!.translate(cx, cy);
      ctx!.rotate((-6 * Math.PI) / 180);
      roundRect(ctx!, -bw / 2, -bh / 2, bw, bh, 22);
      ctx!.fillStyle = `oklch(0.16 0.01 110 / 0.85)`;
      ctx!.fill();
      ctx!.strokeStyle = `oklch(0.78 0.155 110 / ${0.35 + pulse * 0.25})`;
      ctx!.lineWidth = 1.5;
      ctx!.stroke();

      // Screen
      roundRect(ctx!, -bw * 0.42, -bh * 0.38, bw * 0.84, bh * 0.55, 10);
      const sg = ctx!.createLinearGradient(0, -bh * 0.3, 0, bh * 0.2);
      sg.addColorStop(0, `oklch(0.22 0.03 220 / 0.9)`);
      sg.addColorStop(1, `oklch(0.12 0.02 110 / 0.95)`);
      ctx!.fillStyle = sg;
      ctx!.fill();

      // Live readout
      const temp = 72 + Math.sin(t * 0.9) * 8 + Math.sin(t * 2.1) * 3;
      const rpm = 1800 + Math.sin(t * 1.3) * 420 + pulse * 280;
      ctx!.font = `600 ${Math.max(14, bw * 0.045)}px "JetBrains Mono", monospace`;
      ctx!.fillStyle = `oklch(0.78 0.155 110)`;
      ctx!.fillText(`CPU  ${temp.toFixed(1)}°C`, -bw * 0.34, -bh * 0.12);
      ctx!.fillStyle = `oklch(0.72 0.13 220)`;
      ctx!.fillText(`FAN  ${Math.round(rpm)} RPM`, -bw * 0.34, -bh * 0.02);
      ctx!.fillStyle = `oklch(0.96 0.01 110 / 0.7)`;
      ctx!.font = `500 ${Math.max(11, bw * 0.028)}px "JetBrains Mono", monospace`;
      ctx!.fillText("profile  balanced · bias +0.15", -bw * 0.34, bh * 0.1);

      // Fan ring
      const fx = bw * 0.28;
      const fy = bh * 0.22;
      ctx!.strokeStyle = `oklch(0.72 0.13 220 / 0.7)`;
      ctx!.lineWidth = 2;
      ctx!.beginPath();
      ctx!.arc(fx, fy, bw * 0.07, 0, Math.PI * 2);
      ctx!.stroke();
      ctx!.save();
      ctx!.translate(fx, fy);
      ctx!.rotate(t * (2.2 + pulse));
      for (let i = 0; i < 5; i++) {
        ctx!.rotate((Math.PI * 2) / 5);
        ctx!.beginPath();
        ctx!.moveTo(0, 0);
        ctx!.quadraticCurveTo(bw * 0.02, bw * 0.02, 0, bw * 0.065);
        ctx!.strokeStyle = `oklch(0.78 0.155 110 / 0.85)`;
        ctx!.stroke();
      }
      ctx!.restore();
      ctx!.restore();

      // Particles / heat wisps
      if (particles.length < 70) spawn(3);
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 0.008;
        if (p.life <= 0) {
          particles.splice(i, 1);
          continue;
        }
        ctx!.beginPath();
        ctx!.fillStyle = `oklch(0.75 0.14 ${p.hue} / ${p.life * 0.55})`;
        ctx!.arc(p.x, p.y, 2 + (1 - p.life) * 6, 0, Math.PI * 2);
        ctx!.fill();
      }

      // Scan line
      const sy = ((t * 40) % (h + 80)) - 40;
      ctx!.fillStyle = `oklch(0.78 0.155 110 / 0.06)`;
      ctx!.fillRect(0, sy, w, 28);

      raf = requestAnimationFrame(drawFrame);
    }

    function roundRect(
      c: CanvasRenderingContext2D,
      x: number,
      y: number,
      rw: number,
      rh: number,
      r: number,
    ) {
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + rw, y, x + rw, y + rh, r);
      c.arcTo(x + rw, y + rh, x, y + rh, r);
      c.arcTo(x, y + rh, x, y, r);
      c.arcTo(x, y, x + rw, y, r);
      c.closePath();
    }

    function drawStatic() {
      resize();
      t0 = performance.now();
      // one frame without looping
      const once = (now: number) => {
        // reuse loop body by temporarily stopping after one paint
        cancelAnimationFrame(raf);
        const t = 0.8;
        ctx!.clearRect(0, 0, w, h);
        const g = ctx!.createRadialGradient(w * 0.72, h * 0.58, 20, w * 0.72, h * 0.58, Math.max(w, h) * 0.55);
        g.addColorStop(0, `oklch(0.6 0.18 45 / 0.5)`);
        g.addColorStop(0.4, `oklch(0.5 0.14 110 / 0.3)`);
        g.addColorStop(1, `oklch(0.08 0 0 / 0)`);
        ctx!.fillStyle = g;
        ctx!.fillRect(0, 0, w, h);
        void now;
        void t;
        // still draw chassis via one animated frame then cancel
        drawFrame(performance.now());
        cancelAnimationFrame(raf);
      };
      once(performance.now());
    }

    resize();
    window.addEventListener("resize", () => {
      resize();
      if (reduce) drawStatic();
    });

    if (reduce) {
      drawStatic();
    } else {
      raf = requestAnimationFrame(drawFrame);
    }
  }

  bootThermal();
  document.addEventListener("astro:page-load", bootThermal);
</script>
