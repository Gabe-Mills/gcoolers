---
/**
 * Breadcrumbs for secondary pages.
 *
 * Deliberately absent from the homepage: a single-level crumb that reads
 * "Gcoolers" on the page called Gcoolers is noise, and Google drops
 * single-item BreadcrumbList markup anyway.
 *
 * The trail is rendered as an ordered list because that is what it is; the
 * separators are CSS so a screen reader hears "Home, Support" rather than
 * "Home slash Support". The matching BreadcrumbList JSON-LD is emitted by
 * BaseLayout from the same `crumbs` array, so the markup and the structured
 * data can never disagree.
 */
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((c, i) => (
        <li>
          {c.href && i < crumbs.length - 1 ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page">{c.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
