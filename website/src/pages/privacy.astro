---
import BaseLayout from "../layouts/BaseLayout.astro";
import FrostMachineBackground from "../components/react/FrostMachineBackground";
import Navbar from "../components/react/Navbar";
import SiteFooter from "../components/react/SiteFooter";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { site } from "../data/site";
import { history, version } from "../data/product";

const appFiles = [
  { path: "config.json", what: "Settings." },
  { path: "state.json", what: "Current temps, zone, fan %." },
  {
    path: "history.json",
    what: `Last ${history.windowMinutes} min · ≤${history.maxSamples} samples.`,
  },
  { path: "learn.json", what: "Adaptive bias + learned app names. Local only." },
];
---

<BaseLayout
  title="Privacy"
  description="Gcoolers stores data only on your Mac. No telemetry. This site has no analytics."
  path="/privacy"
  crumbs={[{ label: "Home", href: "/" }, { label: "Privacy" }]}
>
  <FrostMachineBackground client:load />
  <Navbar client:load path="/privacy" />

  <main id="main">
    <section class="page wrap">
      <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Privacy" }]} />

      <div class="page-head">
        <p class="mono">Privacy</p>
        <h1>Nothing leaves your Mac.</h1>
        <span class="page-rule" aria-hidden="true"></span>
        <p>Checked against v{version}. If this page and the code disagree, trust the code.</p>
      </div>

      <div class="panel prose-panel">
        <h2>The governor</h2>
        <p>
          No account, no telemetry, no network calls. Sensors → local files → fan targets. Files live in
          <code>~/Library/Application&nbsp;Support/Gcoolers</code>:
        </p>
        <dl class="privacy-files">
          {
            appFiles.map((f) => (
              <div class="privacy-file">
                <dt><code>{f.path}</code></dt>
                <dd>{f.what}</dd>
              </div>
            ))
          }
        </dl>
        <p>
          Log: <code>~/Library/Logs/gcoolers.log</code> (append-only; safe to delete).
          <code class="code-inline">gcoolers export</code> writes to Downloads only when you run it.
        </p>
      </div>

      <div class="panel prose-panel">
        <h2>This website</h2>
        <p>Static GitHub Pages. No analytics, no cookies, no pixels.</p>
        <p>No cookies. No localStorage.</p>
        <h3>Third parties</h3>
        <ul class="privacy-third">
          <li><b>Google Fonts</b> — typefaces; Google sees your IP.</li>
          <li><b>GitHub Pages</b> — hosts the files.</li>
          <li>
            <b>Links you click</b> — GitHub, Buy Me a Coffee, Cash App. Nothing loads until you click.
          </li>
        </ul>
      </div>

      <div class="panel prose-panel">
        <h2>Field reports</h2>
        <p>
          Submitting a <a href="/reviews">review</a> posts to a Cloudflare Worker + D1 database. Stored: what
          you wrote (moderated copy only), consent, salted IP hash + user-agent for rate limits, moderation
          status codes. No serials, phones, or accounts. To remove a report: email{" "}
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>

      <div class="panel prose-panel">
        <h2>Contact</h2>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a> or a{" "}
          <a href={site.issues} target="_blank" rel="noopener noreferrer">GitHub issue</a>. No mailing list.
        </p>
        <p class="privacy-foot mono">v{version}</p>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
