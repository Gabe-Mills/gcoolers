---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FrostMachineBackground from "../../components/react/FrostMachineBackground";
import Navbar from "../../components/react/Navbar";
import SiteFooter from "../../components/react/SiteFooter";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ReviewForm from "../../components/react/ReviewForm";

/*
 * A page rather than a modal.
 *
 * The form is long enough that a sheet would trap a phone keyboard against a
 * scrolling container, and a real URL means someone can be linked straight to
 * it, refresh without losing the page, and use the back button to leave.
 */
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Field reports", href: "/reviews" },
  { label: "New report" },
];
---

<BaseLayout
  title="New field report"
  description="Submit a Gcoolers review. Moderated before it appears. Honest criticism welcome."
  path="/reviews/new"
  crumbs={crumbs}
>
  <FrostMachineBackground client:load />
  <Navbar client:load path="/reviews/new" />

  <main id="main">
    <section class="page wrap page-narrow">
      <Breadcrumbs crumbs={crumbs} />

      <div class="page-head">
        <p class="mono">New field report</p>
        <h1>What happened on your Mac?</h1>
        <span class="page-rule" aria-hidden="true"></span>
        <p>Swearing gets masked. Honest criticism stays. Reviewed before publish.</p>
      </div>

      <ReviewForm client:load />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
