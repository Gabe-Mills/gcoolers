#!/usr/bin/env python3
"""Gcoolers — Apple Silicon fan governor, live monitor, menu bar, launchd."""
from __future__ import annotations

import argparse
import json
import os
import select
import shutil
import signal
import subprocess
import sys
from collections import deque
from typing import Any
from pathlib import Path
import time

ESC = "\033"
HIDE = f"{ESC}[?25l"
SHOW = f"{ESC}[?25h"
HOME = f"{ESC}[H"
CLEAR = f"{ESC}[2J"
CLEAR_EOS = f"{ESC}[J"
RESET = f"{ESC}[0m"
BOLD = f"{ESC}[1m"
DIM = f"{ESC}[2m"
CYAN = f"{ESC}[36m"
GREEN = f"{ESC}[32m"
YELLOW = f"{ESC}[33m"
RED = f"{ESC}[31m"
MAGENTA = f"{ESC}[35m"
BLUE = f"{ESC}[34m"
WHITE = f"{ESC}[37m"

# Density ramp for sonograph cells (low → hot)
RAMP = " ·░▒▓█"
# Vertical waveform levels
WAVE = " ▁▂▃▄▅▆▇█"

INTERVAL = 200
HISTORY_SECS = 60.0
VERSION = "3.01"
PRODUCT = "Gcoolers"
DOMAIN = "gcoolers.com"
URL = "https://gcoolers.com"
REPO_URL = "https://github.com/Gabe-Mills/gcoolers"


def package_root() -> Path:
    """Repo root or Homebrew share/gcoolers prefix."""
    here = Path(__file__).resolve().parent
    # repo checkout: <root>/bin/gcoolers
    if (here.parent / "Sources" / "GcoolersBar.swift").is_file():
        return here.parent
    # brew: <prefix>/bin/gcoolers + <prefix>/share/gcoolers
    share = here.parent / "share" / "gcoolers"
    if (share / "Sources" / "GcoolersBar.swift").is_file():
        return share
    # libexec-adjacent share
    alt = here.parent / "opt" / "gcoolers" / "share" / "gcoolers"
    if (alt / "Sources" / "GcoolersBar.swift").is_file():
        return alt
    return here.parent


def bundled_bin(name: str) -> str | None:
    root = package_root()
    for cand in (
        root / "vendor" / "darwin-arm64" / name,
        root / "libexec" / name,
        Path(__file__).resolve().parent.parent / "libexec" / name,
        Path.home() / "bin" / name,
    ):
        if cand.is_file() and os.access(cand, os.X_OK):
            return str(cand)
    which = shutil.which(name)
    return which


MACMON = bundled_bin("macmon") or os.path.expanduser("~/bin/macmon")
_FAN_CANDIDATES = [
    bundled_bin("heatwatch-fan") or "",
    os.path.expanduser("~/bin/heatwatch-fan"),
    "/opt/homebrew/bin/heatwatch-fan",
    "/usr/local/bin/heatwatch-fan",
    "/Applications/HeatWatch.app/Contents/MacOS/heatwatch-fan",
]
FAN_HELPER = next((p for p in _FAN_CANDIDATES if p and os.path.isfile(p)), os.path.expanduser("~/bin/heatwatch-fan"))


def color_for_pct(p: float) -> str:
    if p >= 90:
        return RED
    if p >= 70:
        return YELLOW
    if p >= 40:
        return GREEN
    return CYAN


def c_to_f(c: float) -> float:
    return c * 9.0 / 5.0 + 32.0


def color_for_temp(f: float) -> str:
    # telemetry bands — emphasize values, not the whole terminal
    if f >= 160:
        return RED
    if f >= 145:
        return YELLOW
    if f >= 130:
        return GREEN
    return CYAN


def color_for_norm(n: float) -> str:
    """n in 0..1 heat scale."""
    if n >= 0.9:
        return RED
    if n >= 0.7:
        return YELLOW
    if n >= 0.4:
        return GREEN
    return CYAN


def bar(ratio: float, width: int = 28) -> str:
    ratio = max(0.0, min(1.0, ratio))
    n = int(round(ratio * width))
    col = color_for_pct(ratio * 100)
    return f"{col}{'█' * n}{DIM}{'░' * (width - n)}{RESET}"


def pct(x: float | None) -> float:
    if x is None:
        return 0.0
    v = float(x)
    return v * 100 if v <= 1.5 else v


def gb(n: float) -> str:
    return f"{n / (1024**3):.1f}G"


def mhz(n: float | int | None) -> str:
    if n is None:
        return "—"
    n = float(n)
    return f"{n/1000:.2f}GHz" if n >= 1000 else f"{n:.0f}MHz"


def watts(n: float | None) -> str:
    if n is None:
        return "—"
    return f"{float(n):.1f}W"


def temp_f(n: float | None) -> str:
    if n is None:
        return "—"
    f = float(n)
    return f"{color_for_temp(f)}{f:.1f}°F{RESET}"


def avg(xs: list[float]) -> float | None:
    return sum(xs) / len(xs) if xs else None


def fmt_avg(v: float | None, kind: str) -> str:
    if v is None:
        return "—"
    if kind == "pct":
        return f"{color_for_pct(v)}{v:.0f}%{RESET}"
    if kind == "temp":
        return temp_f(v)
    if kind == "watt":
        return watts(v)
    return f"{v:.1f}"


def spark(values: list[float], width: int, lo: float, hi: float) -> str:
    """Single-line waveform sparkline."""
    if width < 4:
        return ""
    if not values:
        return DIM + "·" * width + RESET
    # resample last N into width columns
    n = len(values)
    out = []
    span = max(1e-9, hi - lo)
    for i in range(width):
        # take max in bucket for more "alive" look
        a = int(i * n / width)
        b = max(a + 1, int((i + 1) * n / width))
        chunk = values[a:b]
        v = max(chunk) if chunk else lo
        norm = max(0.0, min(1.0, (v - lo) / span))
        ch = WAVE[int(norm * (len(WAVE) - 1))]
        out.append(f"{color_for_norm(norm)}{ch}{RESET}")
    return "".join(out)


def sonograph_lane(
    values: list[float],
    width: int,
    height: int,
    lo: float,
    hi: float,
) -> list[str]:
    """
    Scrolling sonograph / spectrogram-style strip.
    Time → right. Intensity → vertical density + color.
    Each column is one (resampled) sample; rows are intensity bins.
    """
    height = max(3, height)
    width = max(8, width)
    span = max(1e-9, hi - lo)
    # grid[row][col] where row 0 is top (hottest)
    grid = [[" " for _ in range(width)] for _ in range(height)]
    colors = [[DIM for _ in range(width)] for _ in range(height)]

    if values:
        n = len(values)
        for col in range(width):
            a = int(col * n / width)
            b = max(a + 1, int((col + 1) * n / width))
            chunk = values[a:b]
            v = sum(chunk) / len(chunk) if chunk else lo
            norm = max(0.0, min(1.0, (v - lo) / span))
            # fill from bottom up to intensity
            fill = norm * height
            for row in range(height):
                # row 0 = top
                level_from_bottom = height - row
                if fill >= level_from_bottom:
                    ch = "█"
                    intensity = 1.0
                elif fill >= level_from_bottom - 1:
                    frac = fill - (level_from_bottom - 1)
                    ch = RAMP[min(len(RAMP) - 1, int(frac * (len(RAMP) - 1)))]
                    intensity = frac
                else:
                    ch = " "
                    intensity = 0.0
                # heat color by absolute norm, not just cell
                colors[row][col] = color_for_norm(norm) if intensity > 0 else DIM
                grid[row][col] = ch if ch != " " else "·" if row == height - 1 else " "

    lines = []
    for row in range(height):
        cells = []
        for col in range(width):
            ch = grid[row][col]
            if ch == " ":
                cells.append(" ")
            else:
                cells.append(f"{colors[row][col]}{ch}{RESET}")
        # left scale tick
        if row == 0:
            tick = f"{DIM}{hi:>4.0f}{RESET}"
        elif row == height - 1:
            tick = f"{DIM}{lo:>4.0f}{RESET}"
        else:
            tick = "    "
        lines.append(f"  {tick}│{''.join(cells)}│")
    return lines


class History:
    def __init__(self, max_samples: int) -> None:
        self.max = max_samples
        self.cpu: deque[float] = deque(maxlen=max_samples)
        self.gpu: deque[float] = deque(maxlen=max_samples)
        self.cpu_t: deque[float] = deque(maxlen=max_samples)
        self.gpu_t: deque[float] = deque(maxlen=max_samples)
        self.power: deque[float] = deque(maxlen=max_samples)
        self.ts: deque[float] = deque(maxlen=max_samples)

    def push(self, t: float, cpu: float, gpu: float, ct: float, gt: float, pwr: float) -> None:
        self.ts.append(t)
        self.cpu.append(cpu)
        self.gpu.append(gpu)
        self.cpu_t.append(ct)
        self.gpu_t.append(gt)
        self.power.append(pwr)

    def window(self, secs: float, now: float) -> dict[str, list[float]]:
        out: dict[str, list[float]] = {
            "cpu": [],
            "gpu": [],
            "cpu_t": [],
            "gpu_t": [],
            "power": [],
        }
        for i, ts in enumerate(self.ts):
            if now - ts <= secs:
                out["cpu"].append(self.cpu[i])
                out["gpu"].append(self.gpu[i])
                out["cpu_t"].append(self.cpu_t[i])
                out["gpu_t"].append(self.gpu_t[i])
                out["power"].append(self.power[i])
        return out


def section(title: str) -> str:
    return f"{BOLD}{WHITE}{title}{RESET}"


def core_line(label: str, core: dict[str, Any], width: int) -> str:
    r = float(core.get("scaled_ratio") or core.get("active_ratio") or 0)
    f = core.get("freq_mhz")
    cid = core.get("core_id", "?")
    return (
        f"  {DIM}{label}{cid:<4}{RESET}"
        f"{bar(r, width)} "
        f"{color_for_pct(r*100)}{r*100:5.1f}%{RESET}  "
        f"{mhz(f)}"
    )


def render(
    d: dict[str, Any],
    hist: History,
    cols: int,
    rows: int,
    now: float,
    hz: float,
) -> str:
    temp = d.get("temp") or {}
    mem = d.get("memory") or {}
    fans = d.get("fans") or []
    soc = d.get("soc") or {}
    ecpu = d.get("ecpu_cores") or []
    pcpu = d.get("pcpu_cores") or []

    chip = soc.get("chip_name") or soc.get("name") or "Apple Silicon"
    model = soc.get("mac_model") or ""
    ecpu_n = soc.get("ecpu_cores") or len(ecpu)
    pcpu_n = soc.get("pcpu_cores") or len(pcpu)
    gpu_n = soc.get("gpu_cores") or "?"

    cpu_u = pct(d.get("cpu_usage_pct") or d.get("cpu_scaled_ratio") or d.get("cpu_active_ratio"))
    e_u = pct(d.get("ecpu_scaled_ratio") or d.get("ecpu_active_ratio"))
    p_u = pct(d.get("pcpu_scaled_ratio") or d.get("pcpu_active_ratio"))
    g_u = pct(d.get("gpu_scaled_ratio") or d.get("gpu_active_ratio"))
    cpu_t = c_to_f(float(temp.get("cpu_temp_avg") or 0))
    gpu_t = c_to_f(float(temp.get("gpu_temp_avg") or 0))
    # prefer package; fall back to sys when pkg reads 0
    pkg = float(d.get("all_power") or 0)
    sys_p = float(d.get("sys_power") or 0)
    pwr = pkg if pkg > 0.05 else sys_p

    w10 = hist.window(10.0, now)
    w60 = hist.window(60.0, now)

    bw = max(12, min(36, cols - 42))
    graph_w = max(24, cols - 10)

    lines: list[str] = []
    lines.append(
        f"{BOLD}{CYAN}Gcoolers{RESET}  {DIM}{chip}"
        + (f" · {model}" if model else "")
        + f" · {ecpu_n}E+{pcpu_n}P · {gpu_n}GPU{RESET}"
        + f"  {DIM}{hz:.0f}Hz · ~{HISTORY_SECS:.0f}s · q quit · 1/2/3 window{RESET}"
    )
    lines.append("")

    # Averages table
    lines.append(section("NOW / AVG 10s / AVG 60s / SESSION"))
    lines.append(
        f"  {DIM}{'':5}{'now':>8}  {'10s':>8}  {'60s':>8}  {'sess':>8}{RESET}"
    )
    def avg_row(label: str, now_v: float, series: deque[float], w10s: list[float], w60s: list[float], kind: str) -> str:
        return (
            f"  {label:<5}"
            f"{fmt_avg(now_v, kind)}   "
            f"{fmt_avg(avg(w10s), kind)}   "
            f"{fmt_avg(avg(w60s), kind)}   "
            f"{fmt_avg(avg(list(series)), kind)}"
        )

    lines.append(avg_row("CPU%", cpu_u, hist.cpu, w10["cpu"], w60["cpu"], "pct"))
    lines.append(avg_row("GPU%", g_u, hist.gpu, w10["gpu"], w60["gpu"], "pct"))
    lines.append(avg_row("CPU°", cpu_t, hist.cpu_t, w10["cpu_t"], w60["cpu_t"], "temp"))
    lines.append(avg_row("GPU°", gpu_t, hist.gpu_t, w10["gpu_t"], w60["gpu_t"], "temp"))
    lines.append(avg_row("PWR", pwr, hist.power, w10["power"], w60["power"], "watt"))
    lines.append("")

    # Live sparks
    lines.append(section(f"WAVE  (last ~{HISTORY_SECS:.0f}s)"))
    lines.append(f"  CPU  {spark(list(hist.cpu), graph_w - 6, 0, 100)}")
    lines.append(f"  GPU  {spark(list(hist.gpu), graph_w - 6, 0, 100)}")
    lines.append(f"  TEMP {spark(list(hist.cpu_t), graph_w - 6, 86, 221)}")
    lines.append(f"  PWR  {spark(list(hist.power), graph_w - 6, 0, max(40.0, max(hist.power) if hist.power else 40))}")
    lines.append("")

    # Sonograph — stacked lanes (CPU / GPU / TEMP)
    # Budget height from remaining terminal rows
    used = len(lines)
    remain = max(12, rows - used - 14)
    lane_h = max(3, min(7, remain // 3))

    lines.append(section(f"SONOGRAPH  ← older · newer →  (~{HISTORY_SECS:.0f}s)"))
    lines.append(f"  {DIM}CPU util %{RESET}")
    lines.extend(sonograph_lane(list(hist.cpu), graph_w, lane_h, 0, 100))
    lines.append(f"  {DIM}GPU util %{RESET}")
    lines.extend(sonograph_lane(list(hist.gpu), graph_w, lane_h, 0, 100))
    # temp: blend cpu/gpu max for heat picture
    temp_series = [
        max(hist.cpu_t[i], hist.gpu_t[i]) if i < len(hist.gpu_t) else hist.cpu_t[i]
        for i in range(len(hist.cpu_t))
    ]
    lines.append(f"  {DIM}peak temp °F{RESET}")
    lines.extend(sonograph_lane(temp_series, graph_w, lane_h, 95, 221))
    lines.append("")

    # Snapshot strip
    lines.append(section("LIVE"))
    fan_bits = []
    for f in fans:
        rpm = f.get("rpm") or 0
        mx = f.get("max_rpm") or 1
        name = f.get("name") or "fan"
        fan_bits.append(f"{name} {color_for_pct(rpm/mx*100)}{rpm:.0f}{RESET}rpm")
    lines.append(
        f"  CPU {temp_f(cpu_t)}  GPU {temp_f(gpu_t)}  "
        f"pkg {watts(pkg)}  sys {watts(sys_p)}  "
        f"CPU {watts(d.get('cpu_power'))}  GPU {watts(d.get('gpu_power'))}  "
        + ("  ".join(fan_bits) if fan_bits else "")
    )
    lines.append(
        f"  CPU  {bar(cpu_u/100, bw)} {color_for_pct(cpu_u)}{cpu_u:5.1f}%{RESET}"
        f"  E {mhz(d.get('ecpu_freq_mhz'))}  P {mhz(d.get('pcpu_freq_mhz'))}"
    )
    lines.append(
        f"  GPU  {bar(g_u/100, bw)} {color_for_pct(g_u)}{g_u:5.1f}%{RESET}"
        f"  {mhz(d.get('gpu_freq_mhz'))}"
    )

    ram_u = float(mem.get("ram_usage") or 0)
    ram_t = float(mem.get("ram_total") or 1)
    ram_r = ram_u / ram_t if ram_t else 0
    lines.append(
        f"  RAM  {bar(ram_r, bw)} {color_for_pct(ram_r*100)}{ram_r*100:5.1f}%{RESET}"
        f"  {gb(ram_u)}/{gb(ram_t)}"
    )

    # Per-core if room
    budget = rows - len(lines) - 2
    if budget > 6 and (ecpu or pcpu):
        lines.append("")
        show_e = min(len(ecpu), max(0, budget // 3))
        show_p = min(len(pcpu), max(0, budget - show_e - 2))
        if show_e and ecpu:
            lines.append(section(f"E-CORES"))
            for c in ecpu[:show_e]:
                lines.append(core_line("E", c, max(10, bw - 4)))
        if show_p and pcpu:
            lines.append(section(f"P-CORES"))
            for c in pcpu[:show_p]:
                lines.append(core_line("P", c, max(10, bw - 4)))

    out = "\n".join(lines[: max(1, rows - 1)])
    return HOME + out + CLEAR_EOS


def fan_cli(args: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    if not os.path.isfile(FAN_HELPER):
        raise SystemExit(f"missing fan helper: {FAN_HELPER}\nInstall HeatWatch first.")
    # Never let helper spam the thermostat UI
    kwargs = dict(
        check=False,
        text=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    r = subprocess.run(["sudo", "-n", FAN_HELPER, "-q", *args], **kwargs)
    if r.returncode == 0:
        return r
    # sudo ticket expired → re-prompt once
    subprocess.run(
        ["sudo", "-v", "-p", "Password for fan control: "],
        check=False,
    )
    r = subprocess.run(["sudo", "-n", FAN_HELPER, "-q", *args], **kwargs)
    if check and r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, [FAN_HELPER, *args])
    return r


def ensure_sudo(prompt: bool = True) -> bool:
    """True if heatwatch-fan is runnable via sudo (NOPASSWD or cached ticket)."""
    if not os.path.isfile(FAN_HELPER):
        return False
    # Only the fan helper is in /etc/sudoers.d/gcoolers — do NOT test `sudo true`.
    r = subprocess.run(
        ["sudo", "-n", FAN_HELPER, "-q", "status"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if r.returncode == 0:
        return True
    # some builds lack -q
    r = subprocess.run(
        ["sudo", "-n", FAN_HELPER, "status"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if r.returncode == 0:
        return True
    if not prompt:
        return False
    subprocess.run(
        ["sudo", "-v", "-p", "Password for fan control: "],
        check=False,
    )
    r = subprocess.run(
        ["sudo", "-n", FAN_HELPER, "status"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return r.returncode == 0


def fan_blast_all() -> subprocess.CompletedProcess[str]:
    r = fan_cli(["max"], check=False)
    if r.returncode == 0:
        return r
    return fan_cli(["set", "99999"], check=False)


def fan_set_pct(pct: float, fan_maxes: list[int] | None = None) -> subprocess.CompletedProcess[str]:
    pct = max(0.0, min(1.0, pct))
    hi = max(fan_maxes) if fan_maxes else 5777
    rpm = max(1, int(round(hi * pct)))
    return fan_cli(["set", str(rpm)], check=False)


def fan_release() -> subprocess.CompletedProcess[str]:
    return fan_cli(["release"], check=False)


